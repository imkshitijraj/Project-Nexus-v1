# Local development. Never commit .env or put any of these secrets in runtime-config.js.
PORT=4174
HOST=127.0.0.1
NODE_ENV=development
DEMO_SEED=1
# Omit DATABASE_URL locally to use embedded PostgreSQL under .data/postgres.
# DATABASE_URL=postgresql://user:password@localhost:5432/nexus
# Production: strong random secret, at least 48 characters.
# JWT_SECRET=
PUBLIC_URL=http://127.0.0.1:4174
ALLOWED_ORIGINS=http://127.0.0.1:4174,http://localhost:4174
# Production: configure SMTP, for example smtps://user:password@smtp.example.com:465
# SMTP_URL=
# MAIL_FROM=Nexus <no-reply@example.com>
# Enable only behind a single trusted reverse proxy.
TRUST_PROXY=0
# For Pages on another site; browsers may still block third-party refresh cookies.
# Prefer app.example.com + api.example.com instead.
CROSS_SITE_COOKIES=0
