{
  "name": "project-nexus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-project workspace with portfolio analytics and a secured organization API",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "start:server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "start:demo": "node --import tsx scripts/start-demo.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:server": "tsx --test server/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check app.js && node --check model.js && node --check management.js && node --check connection.js && node --check appearance.js && node --check auth-ui.js && node --check account-ui.js",
    "verify": "npm run check && npm run typecheck && npm test && npm run test:server && npm audit --audit-level=high && npm run test:deployment && npm run build:pages",
    "test:ui": "node tests/ui.mjs",
    "test:connected": "node tests/connected.mjs",
    "test:pages": "node tests/pages.mjs",
    "test:appearance": "node tests/appearance.mjs",
    "test:reliability": "node tests/reliability.mjs",
    "test:accounts": "node tests/accounts.mjs",
    "test:deployment": "node --test tests/deployment.mjs",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "playwright": "^1.64.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
